# Public site URL (used for social previews and the sitemap)
NEXT_PUBLIC_SITE_URL=https://www.qorliq.com

# Form delivery via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@qorliq.com
CONTACT_FROM_EMAIL="QORLIQ <site@qorliq.com>"

# Supabase — database, CV storage and the /admin panel (see supabase/README.md)
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Never commit it or expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
